# Copy this to .env for local dev, or set these in Vercel's Environment Variables dashboard

# Generate a new one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts (your Vercel domain + custom domain if any)
# Example: ALLOWED_HOSTS=your-app.vercel.app,yourdomain.com
ALLOWED_HOSTS=*

# PostgreSQL connection string from Neon, Supabase, Railway etc.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/dbname
